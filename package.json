{
  "name": "@leochen0204/grapesjs-mjml",
  "version": "1.0.7-fork-rc.9",
  "description": "MJML Componenets integration in GrapesJS",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "v:patch": "npm version patch -m \"Release v%s\"",
    "build": "grapesjs-cli build --patch=false",
    "start": "grapesjs-cli serve",
    "test": "jest",
    "e2e": "playwright test"
  },
  "files": [
    "/dist",
    "/locale"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leochen0204/mjml.git"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "mjml",
    "wysiwyg"
  ],
  "author": "Artur Arseniev",
  "contributors": [
    "Leo Chen <leochen0204>"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@types/mjml": "^4.7.4",
    "mjml-browser": "^4.18.0"
  },
  "babel": {
    "env": {
      "test": {
        "presets": [
          "@babel/preset-env",
          "@babel/preset-typescript"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.15.7",
    "@babel/preset-typescript": "^7.16.7",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^28.0.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "ajv": "^8.12.0",
    "eslint": "^8.23.0",
    "grapesjs": "^0.22.15",
    "grapesjs-cli": "^4.1.1",
    "jest": "^24.9.0",
    "jsdom": "^26.1.0",
    "mjml-cli": "^4.18.0",
    "regenerator-runtime": "^0.14.1",
    "underscore": "^1.13.1",
    "whatwg-fetch": "^3.6.2"
  }
}
